---
const year = new Date().getFullYear();
const isEn = (Astro.currentLocale || 'hu') === 'en';
---

<footer class="site-footer">
  <div class="container">
    <p>&copy; {year} Prio Consulting Kft. — {isEn ? 'All rights reserved!' : 'Minden jog fenntartva!'}</p>
    <p class="footer-operator">
      {isEn ? 'simonprojects.eu is operated by ' : 'A simonprojects.eu üzemeltetője a '}<a
        href="https://prioconsulting.hu/">Prio Consulting Kft.</a>{isEn ? '' : '.'}
    </p>
    <div class="footer-links">
      <span class="footer-email">info[ at]simonprojects.eu</span>
      <span class="separator">&middot;</span>
      <a href="/impresszum/">{isEn ? 'Legal notice' : 'Impresszum'}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: var(--space-xl) 0;
    margin-top: 0;
    text-align: center;
    background: var(--color-bg);
  }

  .site-footer p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: var(--space-xs);
  }

  .footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    font-size: 0.875rem;
  }

  .separator {
    color: var(--color-text-muted);
  }

  .footer-email {
    color: var(--color-text-muted);
  }

  .footer-operator {
    font-size: 0.8125rem;
  }
</style>
