---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Legal Notice | Prio Consulting Kft. — simonprojects.eu';
const description = 'simonprojects.eu is operated by Prio Consulting Kft. — company details, legal information, contact. IT project management and applied AI from Budapest, Hungary.';
---

<BaseLayout title={title} description={description}>
  <main class="container impresszum-page">
    <h1>Legal Notice</h1>

    <p class="intro">
      simonprojects.eu is operated by <strong>Prio Consulting Kft.</strong> The site serves as the
      company's applied AI workshop and is not a separate legal entity.
    </p>

    <h2>Operator company details</h2>
    <dl>
      <dt>Company name</dt>
      <dd>Prio Consulting Korlátolt Felelősségű Társaság</dd>

      <dt>Short name</dt>
      <dd>Prio Consulting Kft.</dd>

      <dt>Registered seat</dt>
      <dd>1077 Budapest, Wesselényi utca 4., 3.em./15A, Hungary</dd>

      <dt>Mailing address</dt>
      <dd>1108 Budapest, Bányató u. 26, 6 em./27, Hungary</dd>

      <dt>Company registration number</dt>
      <dd>01-09-379383</dd>

      <dt>Tax number</dt>
      <dd>29024331-2-42</dd>

      <dt>EU VAT number</dt>
      <dd>HU29024331</dd>

      <dt>Represented by</dt>
      <dd>Simon András, Managing Director</dd>

      <dt>Phone</dt>
      <dd>+36-30-822-5771</dd>

      <dt>Company email</dt>
      <dd><span class="obf-email">info[ at]prioconsulting.hu</span></dd>

      <dt>Site email</dt>
      <dd><span class="obf-email">info[ at]simonprojects.eu</span></dd>
    </dl>

    <h2>Hosting provider</h2>
    <dl class="legal-details">
      <dt>Name</dt>
      <dd>Websupport Magyarország Kft. (mhosting.hu)</dd>

      <dt>Address</dt>
      <dd>1119 Budapest, Fehérvári út 97-99., Hungary</dd>

      <dt>Phone</dt>
      <dd>+36 1 700 2323</dd>

      <dt>Email</dt>
      <dd><span class="obf-email">info[ at]mhosting.hu</span></dd>
    </dl>

    <h2>Primary legal notice</h2>
    <p>
      Full company details — bank account, copyright and liability disclaimers — are published in
      the official legal notice of Prio Consulting Kft.:
      <a href="https://prioconsulting.hu/impresszum/">prioconsulting.hu/impresszum</a>
    </p>
  </main>
</BaseLayout>

<style>
  .impresszum-page {
    padding: var(--space-4xl) 0;
    max-width: 600px;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--space-lg);
  }

  h2 {
    font-size: 1.25rem;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-lg);
  }

  .intro,
  .impresszum-page p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-sm) var(--space-xl);
  }

  dt {
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  dd {
    font-size: 0.9375rem;
    color: var(--color-text);
  }
</style>
